# Salin menjadi .env.local (lokal) dan isi juga di Vercel → Settings → Environment Variables.
# Nilainya ada di Supabase: Project Settings → API Keys (publishable key aman untuk browser).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Opsional: alamat situs untuk tautan konfirmasi email (default: diambil dari request)
# NEXT_PUBLIC_SITE_URL=https://laras-karya-v2.vercel.app
